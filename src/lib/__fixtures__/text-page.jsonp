window.page1_callback(["<div class=\"newpage\" id=\"page1\" style=\"width: 902px; height:1274px\">\n<div class=text_layer style=\"z-index:2\"><div class=ie_fix>\n&nbsp;\n<div class=\"ff2\" style=\"font-size:117px\">\n<span class=a style=\"left:1588px;top:268px;word-spacing:-3px\">Sample PDF Document</span></div>\n<div class=\"ff1\" style=\"font-size:88px\">\n<span class=a style=\"left:236px;top:926px;word-spacing:-2px\">This is a simple sample <span class=w6></span>PDF document created using Python.</span><span class=a style=\"left:236px;top:1355px;word-spacing:-1px\">It includes a header, footer, and sample text content.</span><span class=a style=\"left:236px;top:1785px;word-spacing:-1px\">You can use this template to create notes, study guides, or reports.</span><span class=a style=\"left:236px;top:2214px;word-spacing:-2px\">Section 1: Introduction</span><span class=a style=\"left:236px;top:2429px;word-spacing:-2px\">This section introduces the topic of <span class=w6></span>the PDF and explains its purpose.</span><span class=a style=\"left:236px;top:2859px;word-spacing:-2px\">Section 2: Example Content</span><span class=a style=\"left:236px;top:3073px;word-spacing:-2px\">Here you can add your main <span class=w6></span>content such as notes, diagrams, tables, or <span class=w7></span>lists.</span><span class=a style=\"left:236px;top:3503px;word-spacing:-3px\">Section 3: Conclusion</span><span class=a style=\"left:236px;top:3718px;word-spacing:-2px\">This section summarizes the content and key points of <span class=w7></span>the PDF.</span></div>\n<div class=\"ff0\" style=\"font-size:72px\">\n<span class=a style=\"left:2134px;top:6131px\">Page 1</span></div>\n</div>\n</div>\n</div>\n\n"]);